# CivicAudit AI - Universal Multi-Provider Environment Configuration Template

LLM_PROVIDER=auto

# 1. OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_AUTO_FREE=true

# 2. Groq (Ultra-Fast Inference with Multi-Key Pool & Auto-Failover on 429 Rate Limit)
# You can supply 1 to 10 keys: either comma-separated or as separate numbered variables.
# When one key hits rate limit (429), CivicAudit instantly auto-rotates to the next key!
GROQ_API_KEY=
GROQ_API_KEY_2=
# GROQ_API_KEY_3=
# GROQ_API_KEY_4=
# GROQ_API_KEY_5=
GROQ_MODEL=llama-3.3-70b-versatile

# 3. DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 4. Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# 5. OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 6. Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# 7. Mistral AI
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# 8. Local Offline LLM (Ollama / LM Studio)
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=llama3

# 9. Generic Custom Provider
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=

# 10. Live Web Search Engines
SERPER_API_KEY=
TAVILY_API_KEY=

# 11. Thresholds
DEFAULT_CURRENCY=USD
WARNING_THRESHOLD_PERCENT=30.0
CRITICAL_THRESHOLD_PERCENT=75.0
